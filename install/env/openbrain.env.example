# openbrain.env — instancia local del plugin openbrain. Modo 600. NO versionar.
# Solo claves OPENBRAIN_*. Valores literales; se expande únicamente ~ o $HOME inicial.
# Copiar a ~/.config/claude/openbrain.env y ajustar.

# --- Cerebro (wiki + qmd) ---
OPENBRAIN_REPO_ROOT=~/knowledge
OPENBRAIN_WIKI_ROOT=~/knowledge/wiki
OPENBRAIN_COLLECTION=openbrain
# Colecciones del mismo host que NO deben mezclarse (solo para avisos de doctor)
OPENBRAIN_OTHER_COLLECTIONS=
OPENBRAIN_EVAL_GOLDEN=~/knowledge/.eval/golden.json
OPENBRAIN_EVAL_METRICS=~/knowledge/.eval/metrics.log
# Días sin medir recall tras los que doctor avisa (0 = nunca avisar)
OPENBRAIN_EVAL_MAX_AGE_DAYS=30

# --- Memoria ---
OPENBRAIN_MEMORY_ROOT=~/.claude/projects
OPENBRAIN_HMAC_KEY=~/.config/claude/memory.hmac
OPENBRAIN_STALE_DAYS=60
OPENBRAIN_MEMORY_INDEX_MAX=165

# --- Doctrina ---
OPENBRAIN_DOCTRINE_DIR=~/.claude/doctrine
OPENBRAIN_DOCTRINE_TTL=43200
# Techo de turnos del curator IA en cada consolidación de doctrina
OPENBRAIN_REVIEW_MAX_TURNS=30
# cwd autorizados (uno por línea) para regenerar TAMBIÉN el CLAUDE.md local del proyecto
OPENBRAIN_REFRESH_ALLOWLIST=~/.claude/refresh-allowlist
# Una frase que describe al operador para el prompt de revisión de doctrina
OPENBRAIN_OPERATOR_CONTEXT=operador técnico
# Repo de código cuyos commits recientes se adjuntan a la revisión (vacío = ninguno)
OPENBRAIN_CODE_REPO=

# --- Captura activa (graba prompts redactados; ver README §Privacidad) ---
OPENBRAIN_CAPTURE_ENABLED=1
OPENBRAIN_CAPTURE_TTL_DAYS=14
OPENBRAIN_CAPTURE_MAX_PER_SESSION=40

# --- Firma en Stop (memorias editadas en la sesión que quedaron sin firma) ---
OPENBRAIN_SIGN_ON_STOP=1
# Tope de ficheros fallando por encima del cual no se firma nada (clave rotada o manipulación)
OPENBRAIN_SIGN_ON_STOP_MAX=25

# --- Backup cifrado (los dos vacíos = desactivado; age gana si están ambos) ---
# age: recipient público (age1...). restore descifra con OPENBRAIN_BACKUP_AGE_IDENTITY.
OPENBRAIN_BACKUP_AGE=
# gpg: huella COMPLETA (40 hex) de la clave del recipient
OPENBRAIN_BACKUP_GPG=
OPENBRAIN_BACKUP_DIR=~/.claude/backups/memory
# Copias que se conservan (las más recientes)
OPENBRAIN_BACKUP_KEEP=30
# Huella gpg con la que firmar además el backup (vacío = sin firma)
OPENBRAIN_BACKUP_SIGN_KEY=
# Identidad age con la que restore descifra
OPENBRAIN_BACKUP_AGE_IDENTITY=~/.config/claude/memory-backup-key.txt
